-- SETTINGS & STATE
local ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.U
local ACTION_DELAY = 0

local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local PathfindingService = game:GetService("PathfindingService")

local neighborCache = {}
local isMoving = false
local blockers = {}
local safeSet = {}

-------------------------------------------------
-- UTIL
-------------------------------------------------
local function chatNotify(msg)
    game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
        Text = "[Solver]: " .. msg,
        Color = Color3.fromRGB(255,255,255),
        Font = Enum.Font.GothamBold
    })
end

local function isCellOpen(part)
    if not part or not part.Parent then return true end
    local isBeige = (part.Color.R > 0.7 and part.Color.G > 0.7 and part.Color.B < 0.6)
    return part.Transparency > 0.5 or isBeige or part:FindFirstChild("NumberGui")
end

-------------------------------------------------
-- ROUND DETECTION
-------------------------------------------------
local function anyRevealed()
    local folder = workspace.Flag and workspace.Flag:FindFirstChild("Parts")
    if not folder then return false end
    for _, p in ipairs(folder:GetChildren()) do
        if isCellOpen(p) then
            return true
        end
    end
    return false
end

-------------------------------------------------
-- BLOCKERS
-------------------------------------------------
local function removeBlocker(cell)
    if blockers[cell] then
        blockers[cell]:Destroy()
        blockers[cell] = nil
    end
end

local function placeBlocker(cell)
    if blockers[cell] or safeSet[cell] then return end
    local b = Instance.new("Part")
    b.Size = Vector3.new(6,100,6)
    b.Transparency = 1
    b.Anchored = true
    b.CanCollide = true
    b.CFrame = cell.CFrame * CFrame.new(0,50,0)
    b.Parent = workspace
    blockers[cell] = b
end

-------------------------------------------------
-- DATA SCRAPER
-------------------------------------------------
local function getSolverData()
    local folder = workspace.Flag and workspace.Flag:FindFirstChild("Parts")
    if not folder then return {} end

    local numberData = {}
    local allParts = folder:GetChildren()

    for _, cell in ipairs(allParts) do
        if not isCellOpen(cell) then
            placeBlocker(cell)
            continue
        end

        local label = cell:FindFirstChild("NumberGui") and cell.NumberGui:FindFirstChildOfClass("TextLabel")
        local val = (label and tonumber(label.Text)) or 0

        if not neighborCache[cell] then
            local nbs = {}
            for _, n in ipairs(allParts) do
                if n ~= cell and (n.Position - cell.Position).Magnitude < (cell.Size.X * 1.8) then
                    table.insert(nbs, n)
                end
            end
            neighborCache[cell] = nbs
        end

        local hidden, mines = {}, 0
        for _, n in ipairs(neighborCache[cell]) do
            if not isCellOpen(n) then
                if n.Color == Color3.new(0,0,0) then
                    mines += 1
                else
                    table.insert(hidden, n)
                    placeBlocker(n)
                end
            end
        end

        if #hidden > 0 or val == 0 then
            table.insert(numberData, {obj = cell, eVal = val - mines, hidden = hidden})
        end
    end
    return numberData
end

-------------------------------------------------
-- MOVEMENT
-------------------------------------------------
local function teleportTo(target)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    root.CFrame = target.CFrame * CFrame.new(0,2.8,0)
    root.Velocity = Vector3.new(0,-120,0)
end

-------------------------------------------------
-- SOLVER
-------------------------------------------------
local function runSolver()
    if not ENABLED or isMoving then return end
    if not anyRevealed() then return end

    local data = getSolverData()
    local safeQueue = {}

    -- BASIC + EULER
    for _, d in ipairs(data) do
        if #d.hidden > 0 then
            if d.eVal <= 0 then
                for _, n in ipairs(d.hidden) do
                    safeSet[n] = true
                    removeBlocker(n)
                    table.insert(safeQueue, n)
                end
            elseif #d.hidden == d.eVal then
                for _, n in ipairs(d.hidden) do
                    n.Color = Color3.new(0,0,0)
                end
            end
        end
    end

    if #safeQueue > 0 then
        teleportTo(safeQueue[1])
    end
end

-------------------------------------------------
-- TOGGLE & LOOP
-------------------------------------------------
UserInputService.InputBegan:Connect(function(input,gpe)
    if not gpe and input.KeyCode == TOGGLE_KEY then
        ENABLED = not ENABLED
        neighborCache = {}
        safeSet = {}
        chatNotify("Solver "..(ENABLED and "ON" or "OFF"))
    end
end)

task.spawn(function()
    while true do
        pcall(runSolver)
        task.wait(0.05)
    end
end)

chatNotify("Safe Solver Loaded")
