-- SETTINGS & STATE
local ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.U
local ACTION_DELAY = 0
local WALK_MAX_PATH_LENGTH = 40
local WAYPOINT_TIMEOUT = 2
local TELEPORT_MARGIN = 3
local PILLAR_SIZE = Vector3.new(6, 100, 6)

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local neighborCache = {}
local isMoving = false
local processedParts = {}
local blockers = {}
local blockerFolder = workspace:FindFirstChild("SolverBlockers")
if not blockerFolder then
    blockerFolder = Instance.new("Folder")
    blockerFolder.Name = "SolverBlockers"
    blockerFolder.Parent = workspace
end

-- Helpers
local function chatNotify(msg)
    pcall(function()
        game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
            Text = "[Solver]: " .. msg,
            Color = Color3.fromRGB(255,255,255),
            Font = Enum.Font.GothamBold
        })
    end)
end

local function isCellOpen(part)
    if not part or not part.Parent then return true end
    local ok, c = pcall(function() return part.Color end)
    if not ok or not c then return true end
    local isBeige = (c.R > 0.7 and c.G > 0.7 and c.B < 0.6)
    return (part.Transparency and part.Transparency > 0.5) or isBeige or (part:FindFirstChild("NumberGui") ~= nil)
end

local function isFlagged(part)
    return part:FindFirstChild("Flag") or part:FindFirstChild("BombFlag") or part:FindFirstChild("FlagModel")
end

-- Data scraping
local function getSolverData()
    local folder = workspace:FindFirstChild("Flag") and workspace.Flag:FindFirstChild("Parts")
    if not folder then return {} end
    local numberData = {}
    local allParts = folder:GetChildren()
    for _, cell in ipairs(allParts) do
        if isCellOpen(cell) then
            local label = cell:FindFirstChild("NumberGui") and cell.NumberGui:FindFirstChildOfClass("TextLabel")
            local val = (label and tonumber(label.Text)) or 0
            if not neighborCache[cell] then
                local nbs = {}
                for _, n in ipairs(allParts) do
                    if n ~= cell and (n.Position - cell.Position).Magnitude < (cell.Size.X * 1.8) then
                        table.insert(nbs, n)
                    end
                end
                neighborCache[cell] = nbs
            end
            local hidden, mines = {}, 0
            for _, n in ipairs(neighborCache[cell]) do
                if not isCellOpen(n) then
                    if n.Color == Color3.new(0,0,0) then
                        mines = mines + 1
                    else
                        table.insert(hidden, n)
                    end
                end
            end
            if #hidden > 0 or val == 0 then
                table.insert(numberData, {obj = cell, eVal = val - mines, hidden = hidden})
            end
        end
    end
    return numberData
end

-- Blocker management
local function ensureBlockerFor(part)
    if not part or not part.Parent then return end
    if blockers[part] and blockers[part].Parent then return end
    if isFlagged(part) then return end -- skip flagged tiles

    local b = Instance.new("Part")
    b.Name = "SolverBlocker"
    b.Size = PILLAR_SIZE
    b.Anchored = true
    b.CanCollide = true
    b.CanQuery = false
    b.CanTouch = false
    b.CastShadow = false
    b.Transparency = 1
    b.Material = Enum.Material.SmoothPlastic
    b.CFrame = CFrame.new(part.Position.X, part.Position.Y + (PILLAR_SIZE.Y/2), part.Position.Z)
    b.Parent = blockerFolder
    blockers[part] = b
end

local function removeBlockerFor(part)
    local b = blockers[part]
    if b and b.Parent then
        pcall(function() b:Destroy() end)
    end
    blockers[part] = nil
end

local function updateBlockers(allowPassSet)
    local folder = workspace:FindFirstChild("Flag") and workspace.Flag:FindFirstChild("Parts")
    if not folder then
        for _, b in pairs(blockers) do if b and b.Parent then pcall(function() b:Destroy() end) end end
        blockers = {}
        return
    end

    local keep = {}
    for _, p in ipairs(folder:GetChildren()) do
        if not p or not p.Parent then continue end
        local covered = not isCellOpen(p)
        local ok, val = pcall(function() return p.Color end)
        local isMarkedMine = (ok and val and val == Color3.new(0,0,0))
        local allowed = (allowPassSet and allowPassSet[p]) or processedParts[p] or isFlagged(p)
        if (covered or isMarkedMine) and not allowed then
            ensureBlockerFor(p)
            keep[p] = true
        end
    end

    for partRef, _ in pairs(blockers) do
        if not keep[partRef] then
            removeBlockerFor(partRef)
        end
    end
end

-- Pathfinder
local function computePath(startPos, endPos, maxLen)
    local ok, pathOrErr = pcall(function()
        local path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true
        })
        path:ComputeAsync(startPos, endPos)
        return path
    end)
    if not ok or not pathOrErr then return false, nil, nil end
    local path = pathOrErr
    if path.Status ~= Enum.PathStatus.Success then return false, path, nil end
    local waypoints = path:GetWaypoints()
    local length = 0
    for i = 2, #waypoints do
        length = length + (waypoints[i].Position - waypoints[i-1].Position).Magnitude
    end
    if maxLen and length > maxLen then return false, path, length end
    return true, path, length
end

local function followPathWaypoints(humanoid, root, path)
    if not path or not humanoid or not root then return false end
    local waypoints = path:GetWaypoints()
    if not waypoints or #waypoints == 0 then return false end

    for _, wp in ipairs(waypoints) do
        if wp.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        humanoid:MoveTo(wp.Position)
        local start = tick()
        while (root.Position - wp.Position).Magnitude > 3 do
            if tick() - start > WAYPOINT_TIMEOUT then return false end
            task.wait(0.08)
        end
    end
    return true
end

local function safeWalkToPart(targetPart)
    if not targetPart or not targetPart.Parent then return false end
    local char = player.Character
    local humanoid = char and char:FindFirstChild("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or isMoving then return false end

    isMoving = true
    local startPos = root.Position
    local success, pathObj, length = computePath(startPos, targetPart.Position, WALK_MAX_PATH_LENGTH)
    if not success or not pathObj then isMoving = false; return false end
    local ok = followPathWaypoints(humanoid, root, pathObj)
    task.wait(ACTION_DELAY)
    isMoving = false
    if ok and (root.Position - targetPart.Position).Magnitude <= ((targetPart.Size and math.max(targetPart.Size.X, targetPart.Size.Z) or 3) * 1.5) then
        return true
    else
        return false
    end
end

local function teleportToPart(targetPart)
    if not targetPart or not targetPart.Parent or not player then return false end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, (targetPart.Size.Y/2)+TELEPORT_MARGIN, 0))
    return true
end

-- Main Solver
local function runSolver()
    if not ENABLED or isMoving then return end

    local folder = workspace:FindFirstChild("Flag") and workspace.Flag:FindFirstChild("Parts")
    if not folder then return end
    local allParts = folder:GetChildren()

    -- Detect start of round: no revealed tiles
    local hasRevealed = false
    for _, p in ipairs(allParts) do
        if isCellOpen(p) then hasRevealed = true; break end
    end
    if not hasRevealed then return end -- round starting, don't teleport

    local data = getSolverData()
    if #data == 0 then return end
    local safeQueue = {}
    local foundAnything = false

    -- Subset deduction
    for i = 1, #data do
        for j = 1, #data do
            if i ~= j then
                local d1, d2 = data[i], data[j]
                if (d1.obj.Position - d2.obj.Position).Magnitude < 12 then
                    local s1, s2 = d1.hidden, d2.hidden
                    local isSubset = true
                    for _, x in ipairs(s1) do
                        local inS2 = false
                        for _, y in ipairs(s2) do if x==y then inS2=true; break end end
                        if not inS2 then isSubset=false; break end
                    end
                    if isSubset and #s2>#s1 then
                        local diffMines = d2.eVal - d1.eVal
                        if diffMines==0 then
                            for _, x in ipairs(s2) do
                                local inS1=false
                                for _, y in ipairs(s1) do if x==y then inS1=true; break end end
                                if not inS1 then table.insert(safeQueue, x); foundAnything=true end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Basic safe tiles
    for _, d in ipairs(data) do
        if #d.hidden>0 and d.eVal<=0 then
            for _, n in ipairs(d.hidden) do
                table.insert(safeQueue, n)
                foundAnything=true
            end
        end
    end

    -- Remove duplicates & already processed
    local uniq, uniqueQueue = {}, {}
    for _, p in ipairs(safeQueue) do
        if p and p.Parent and not uniq[p] and not processedParts[p] then
            uniq[p]=true
            uniqueQueue[#uniqueQueue+1]=p
        end
    end

    local allowPassSet = {}
    for _, p in ipairs(uniqueQueue) do allowPassSet[p]=true end
    for p,_ in pairs(processedParts) do allowPassSet[p]=true end
    for _, p in ipairs(allParts) do if isFlagged(p) then allowPassSet[p]=true end end

    updateBlockers(allowPassSet)

    if #uniqueQueue>0 then
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local playerPos = root and root.Position
        if playerPos then table.sort(uniqueQueue, function(a,b) return (a.Position-playerPos).Magnitude<(b.Position-playerPos).Magnitude end) end

        for _, target in ipairs(uniqueQueue) do
            if not processedParts[target] then
                local canWalk = false
                if playerPos then
                    local ok, path = computePath(playerPos, target.Position, WALK_MAX_PATH_LENGTH)
                    if ok and path then canWalk=true end
                end
                if canWalk then
                    local walkedOK = safeWalkToPart(target)
                    if walkedOK then processedParts[target]=true; break end
                else
                    local teleOK = teleportToPart(target)
                    if teleOK then processedParts[target]=true; break end
                end
            end
        end
    end
end

-- Toggle
UserInputService.InputBegan:Connect(function(input,gpe)
    if gpe then return end
    if input.KeyCode==TOGGLE_KEY then
        ENABLED = not ENABLED
        neighborCache={}
        processedParts={}
        if not ENABLED then for _,b in pairs(blockers) do if b.Parent then pcall(function() b:Destroy() end) end end blockers={} end
        chatNotify("Solver "..(ENABLED and "ON" or "OFF"))
    end
end)

if player then
    player.CharacterAdded:Connect(function(char)
        neighborCache={}
        processedParts={}
        isMoving=false
    end)
end

-- Main Loop
task.spawn(function()
    while true do
        pcall(runSolver)
        task.wait(0.05)
    end
end)

chatNotify("Safe-Walk Solver with Flag Detection Loaded. Press 'U' to Toggle.")
