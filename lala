-- Walk-only Minesweeper solver (tuned fixes)
-- - Flag placement/removal uses FLAG_PLACE_RANGE
-- - Click delay added (CLICK_DELAY)
-- - Reduced jitter with ACTION_COOLDOWN and TEMP_BLOCK_DURATION
-- Toggle with U

-- =============== TUNABLES =================
local TOGGLE_KEY = Enum.KeyCode.U
local ACTION_DELAY = 0          -- pause after arriving on tile
local ACTION_COOLDOWN = 0.20    -- small cooldown after any action to reduce jitter
local WALK_MAX_PATH_LENGTH = 40 -- primary max allowed path length (studs)
local FALLBACK_MAX_PATH = 200   -- allowed fallback path length
local WAYPOINT_TIMEOUT = 2      -- seconds allowed to reach each waypoint
local PILLAR_SIZE = Vector3.new(6, 100, 6)
local FLAG_PLACE_RANGE = 15     -- radius to place/remove flags (same for both)
local CLICK_DELAY = 0.15        -- delay after firing a click detector
local TEMP_BLOCK_DURATION = 1.0 -- seconds to skip a target after failed walking attempt
-- ==========================================

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer

-- Original solver state & helpers preserved
local config = { TotalMines = 20, DistanceWeight = 0.1, EdgePenalty = 0.05, Debug = false }
local state = { cells = { grid = {}, numbered = {}, toFlag = {}, toClear = {} }, grid = { w = 0, h = 0 }, lastPartCount = -1, lastNumberedCount = 0 }
local abs, floor, huge = math.abs, math.floor, math.huge
local tsort = table.sort

local neighborCache = {}
local flaggedDebounce = {}
local lastActionTime = 0
local tempBlocked = {}      -- part -> unblockTime
local isMoving = false

local function chatNotify(msg)
    pcall(function()
        StarterGui:SetCore("ChatMakeSystemMessage", {
            Text = "[Solver]: " .. msg,
            Color = Color3.fromRGB(200,200,200),
            Font = Enum.Font.GothamBold
        })
    end)
end

local function isNumber(str) return tonumber(str) ~= nil end

local function hasFlagChild(parent)
    for _, child in ipairs(parent:GetChildren()) do
        if child.Name:sub(1,4) == "Flag" then return true end
    end
    return false
end

local function isCellOpen(part)
    if not part or not part.Parent then return true end
    local ok, c = pcall(function() return part.Color end)
    if not ok or not c then return true end
    local isBeige = (c.R > 0.7 and c.G > 0.7 and c.B < 0.6)
    return (part.Transparency and part.Transparency > 0.5) or isBeige or (part:FindFirstChild("NumberGui") ~= nil)
end

--------------------------------------------------------------------------------
-- Grid & original logic (kept intact)
--------------------------------------------------------------------------------

local function clusterAndAverage(values, maxDiff)
    local clusters, n = {}, #values
    if n == 0 then return clusters end
    local current, count = values[1], 1
    for i = 2, n do
        local v = values[i]
        if abs(v - current) <= maxDiff then
            count = count + 1
            current = current + (v - current) / count
        else
            table.insert(clusters, current)
            current, count = v, 1
        end
    end
    table.insert(clusters, current)
    return clusters
end

local function median(values)
    local n = #values
    if n == 0 then return nil end
    tsort(values)
    return values[floor((n + 1) / 2)]
end

local function estimateSpacing(coords)
    if #coords < 3 then return 4 end
    local diffs = {}
    for i = 2, #coords do diffs[#diffs + 1] = abs(coords[i] - coords[i-1]) end
    return median(diffs) or 4
end

local function findClosestIndex(target, sorted)
    local bestIdx, bestDist = 1, huge
    for i = 1, #sorted do
        local dist = abs(target - sorted[i])
        if dist < bestDist then bestDist, bestIdx = dist, i end
    end
    return bestIdx - 1
end

local function rebuildGridFromParts(folder)
    state.cells.grid = {}
    state.grid.w = 0; state.grid.h = 0
    local parts = folder:GetChildren()
    if #parts == 0 then return end
    local allPositions = {}; local sumY = 0
    for _, part in ipairs(parts) do table.insert(allPositions, { part = part, pos = part.Position }); sumY = sumY + part.Position.Y end

    local xs, zs = {}, {}
    for _, d in ipairs(allPositions) do xs[#xs+1] = d.pos.X; zs[#zs+1] = d.pos.Z end
    tsort(xs); tsort(zs)

    local cellWidth = estimateSpacing(xs) * 0.6
    local cellHeight = estimateSpacing(zs) * 0.6
    local uniqueX = clusterAndAverage(xs, cellWidth)
    local uniqueZ = clusterAndAverage(zs, cellHeight)

    state.grid.w = #uniqueX; state.grid.h = #uniqueZ
    if state.grid.w == 0 or state.grid.h == 0 then return end

    local avgY = sumY / #parts
    for x = 0, state.grid.w - 1 do
        state.cells.grid[x] = {}
        for z = 0, state.grid.h - 1 do
            state.cells.grid[x][z] = { ix = x, iz = z, pos = Vector3.new(uniqueX[x+1], avgY, uniqueZ[z+1]), part = nil, state = "unknown", number = nil, covered = true, neigh = nil }
        end
    end

    for _, data in ipairs(allPositions) do
        local pos, part = data.pos, data.part
        local xIdx = findClosestIndex(pos.X, uniqueX)
        local zIdx = findClosestIndex(pos.Z, uniqueZ)
        local cell = state.cells.grid[xIdx][zIdx]
        if not cell.part then cell.part = part; cell.pos = pos
        else
            local currDist = (cell.part.Position - Vector3.new(uniqueX[xIdx+1], cell.part.Position.Y, uniqueZ[zIdx+1])).Magnitude
            local newDist = (pos - Vector3.new(uniqueX[xIdx+1], pos.Y, uniqueZ[zIdx+1])).Magnitude
            if newDist < currDist then cell.part = part; cell.pos = pos end
        end
    end

    for z = 0, state.grid.h - 1 do
        for x = 0, state.grid.w - 1 do
            local cell, neighbors = state.cells.grid[x][z], {}
            for dz = -1, 1 do for dx = -1, 1 do
                if not (dx == 0 and dz == 0) then
                    local nx, nz = x + dx, z + dz
                    if nx >= 0 and nx < state.grid.w and nz >= 0 and nz < state.grid.h then neighbors[#neighbors + 1] = state.cells.grid[nx][nz] end
                end
            end end
            cell.neigh = neighbors
        end
    end
end

local function updateCellStates(folder)
    state.cells.numbered = {}
    if state.grid.w == 0 then return end
    for x = 0, state.grid.w - 1 do
        local column = state.cells.grid[x]
        if column then
            for z = 0, state.grid.h - 1 do
                local cell = column[z]
                if cell and cell.part then
                    cell.state = "unknown"; cell.number = nil; cell.covered = true; cell.color = nil
                    local partColor = cell.part.Color
                    if partColor then
                        local r = (partColor.R <= 1) and floor(partColor.R * 255 + 0.5) or partColor.R
                        local g = (partColor.G <= 1) and floor(partColor.G * 255 + 0.5) or partColor.G
                        local b = (partColor.B <= 1) and floor(partColor.B * 255 + 0.5) or partColor.B
                        cell.color = {R = r, G = g, B = b}
                    end
                    local numberGui = cell.part:FindFirstChild("NumberGui")
                    if numberGui then
                        local label = numberGui:FindFirstChild("TextLabel")
                        if label and isNumber(label.Text) then cell.number = tonumber(label.Text); cell.covered = false end
                    end
                    local color = cell.color
                    local hasGui = cell.part:FindFirstChild("NumberGui") ~= nil
                    local isRevealed = hasGui
                    if color and not hasGui then
                        local r = math.floor(color.R * 255 + 0.5)
                        local g = math.floor(color.G * 255 + 0.5)
                        local b = math.floor(color.B * 255 + 0.5)
                        if r >= 180 and g >= 180 and b >= 180 and math.abs(r-g) <= 50 and math.abs(g-b) <= 50 and math.abs(r-b) <= 50 then
                            isRevealed = true
                        end
                    end
                    if isRevealed then cell.covered = false end
                    if hasFlagChild(cell.part) then cell.state = "flagged" end
                    if cell.number and not cell.covered then
                        cell.state = "number"
                        state.cells.numbered[#state.cells.numbered + 1] = cell
                    end
                end
            end
        end
    end
end

-- Deduction helpers from original (kept)
local function getUnknownNeighborsExcluding(cell, flaggedSet, safeSet)
    local result = {}
    for _, n in ipairs(cell.neigh) do
        if not flaggedSet[n] and not safeSet[n] and not (n.state == "number" or n.state == "flagged") and n.covered ~= false then
            result[#result + 1] = n
        end
    end
    return result
end

local function countRemainingMines(cell, flaggedSet)
    local remaining = cell.number or 0
    for _, n in ipairs(cell.neigh) do if flaggedSet[n] or n.state == "flagged" then remaining = remaining - 1 end end
    return remaining
end

local function applySimpleDeductionRule(cellA, cellB, unknownsA, unknownsB, flaggedSet, safeSet)
    local setA, intersection = {}, {}
    for _, u in ipairs(unknownsA) do setA[u] = true end
    local onlyA, onlyB = {}, {}
    for _, u in ipairs(unknownsB) do if setA[u] then table.insert(intersection, u); setA[u] = nil else table.insert(onlyB, u) end end
    for u in pairs(setA) do table.insert(onlyA, u) end

    local minesA = countRemainingMines(cellA, flaggedSet)
    local minesB = countRemainingMines(cellB, flaggedSet)

    if #onlyA == 0 and #onlyB > 0 then
        local diff = minesB - minesA
        if diff == 0 then for _, u in ipairs(onlyB) do safeSet[u] = true end
        elseif diff == #onlyB then for _, u in ipairs(onlyB) do flaggedSet[u] = true end end
    end
    if #onlyB == 0 and #onlyA > 0 then
        local diff = minesA - minesB
        if diff == 0 then for _, u in ipairs(onlyA) do safeSet[u] = true end
        elseif diff == #onlyA then for _, u in ipairs(onlyA) do flaggedSet[u] = true end end
    end
end

local function checkAdjacentNumberedCells(flaggedSet, safeSet)
    local numbered, grid = state.cells.numbered, state.cells.grid
    for _, cell in ipairs(numbered) do
        for dz = -1, 1 do for dx = -1, 1 do
            if not (dx == 0 and dz == 0) then
                local nx, nz = cell.ix + dx, cell.iz + dz
                if nx >= 0 and nx < state.grid.w and nz >= 0 and nz < state.grid.h then
                    local adj = grid[nx][nz]
                    if adj and adj.state == "number" then
                        local unknownsThis = getUnknownNeighborsExcluding(cell, flaggedSet, safeSet)
                        local unknownsAdj = getUnknownNeighborsExcluding(adj, flaggedSet, safeSet)
                        if #unknownsThis > 0 and #unknownsAdj > 0 then applySimpleDeductionRule(cell, adj, unknownsThis, unknownsAdj, flaggedSet, safeSet) end
                    end
                end
            end
        end end
    end
end

local function updateLogic()
    if state.grid.w == 0 then state.cells.toFlag = {}; state.cells.toClear = {}; return end
    local numbered = state.cells.numbered
    if #numbered == 0 then state.cells.toFlag = {}; state.cells.toClear = {}; return end

    local knownFlags = {}
    for x = 0, state.grid.w - 1 do
        local col = state.cells.grid[x]
        if col then
            for z = 0, state.grid.h - 1 do
                local cell = col[z]
                if cell and cell.state == "flagged" then knownFlags[cell] = true end
            end
        end
    end

    local changed, iterations = true, 0
    while changed and iterations < 64 do
        changed = false; iterations = iterations + 1
        for _, cell in ipairs(numbered) do
            local unknowns, flagCount = {}, 0
            for _, n in ipairs(cell.neigh) do
                if knownFlags[n] or n.state == "flagged" then flagCount = flagCount + 1
                elseif not state.cells.toClear[n] and not (n.state == "number" or n.state == "flagged") and n.covered ~= false then unknowns[#unknowns + 1] = n end
            end
            local remaining = (cell.number or 0) - flagCount
            if remaining > 0 and remaining == #unknowns then
                for _, u in ipairs(unknowns) do if not knownFlags[u] then knownFlags[u] = true; changed = true end end
            elseif remaining == 0 and #unknowns > 0 then
                for _, u in ipairs(unknowns) do if not state.cells.toClear[u] then state.cells.toClear[u] = true; changed = true end end
            end
        end
        checkAdjacentNumberedCells(knownFlags, state.cells.toClear)
    end
    state.cells.toFlag = knownFlags
end

--------------------------------------------------------------------------------
-- Movement, blockers and flagging (improved)
--------------------------------------------------------------------------------

local processedParts = {} -- part -> true visited
local blockersMap = {}    -- part -> blockerPart
local blockerFolder = workspace:FindFirstChild("SolverBlockers")
if not blockerFolder then blockerFolder = Instance.new("Folder"); blockerFolder.Name = "SolverBlockers"; blockerFolder.Parent = workspace end

local function ensureBlockerFor(part)
    if not part or not part.Parent then return end
    if blockersMap[part] and blockersMap[part].Parent then return end
    if hasFlagChild(part) then return end
    local b = Instance.new("Part")
    b.Name = "SolverBlocker"; b.Size = PILLAR_SIZE; b.Anchored = true
    b.CanCollide = true; b.CanQuery = false; b.CanTouch = false; b.CastShadow = false
    b.Transparency = 1; b.Material = Enum.Material.SmoothPlastic
    b.CFrame = CFrame.new(part.Position.X, part.Position.Y + (PILLAR_SIZE.Y/2), part.Position.Z)
    b.Parent = blockerFolder
    blockersMap[part] = b
end

local function removeBlockerFor(part)
    local b = blockersMap[part]
    if b and b.Parent then pcall(function() b:Destroy() end) end
    blockersMap[part] = nil
end

local function updateBlockers(allowPassParts)
    local folder = workspace:FindFirstChild("Flag")
    local partsFolder = folder and folder:FindFirstChild("Parts")
    if not partsFolder then
        for k, v in pairs(blockersMap) do if v and v.Parent then pcall(function() v:Destroy() end) end end
        blockersMap = {}
        return
    end

    local keep = {}
    local allParts = partsFolder:GetChildren()
    for _, p in ipairs(allParts) do
        if not p or not p.Parent then
        else
            local covered = not isCellOpen(p)
            local ok, col = pcall(function() return p.Color end)
            local isMarkedMine = ok and col and col == Color3.new(0,0,0)
            local allowed = false
            if allowPassParts and allowPassParts[p] then allowed = true end
            if processedParts[p] then allowed = true end
            if hasFlagChild(p) then allowed = true end
            if (covered or isMarkedMine) and not allowed then ensureBlockerFor(p); keep[p] = true end
        end
    end

    for partRef, _ in pairs(blockersMap) do
        if not keep[partRef] then removeBlockerFor(partRef) end
    end
end

-- path helpers with fallback
local function computePath(startPos, endPos, maxLen)
    local ok, pathOrErr = pcall(function()
        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
        path:ComputeAsync(startPos, endPos)
        return path
    end)
    if not ok or not pathOrErr then return false, nil, nil end
    local path = pathOrErr
    if path.Status ~= Enum.PathStatus.Success then return false, path, nil end
    local wps = path:GetWaypoints()
    local len = 0
    for i = 2, #wps do len = len + (wps[i].Position - wps[i-1].Position).Magnitude end
    if maxLen and len > maxLen then return false, path, len end
    return true, path, len
end

local function followPathWaypoints(humanoid, root, path)
    if not path or not humanoid or not root then return false end
    local wps = path:GetWaypoints()
    if not wps or #wps == 0 then return false end
    for _, wp in ipairs(wps) do
        if wp.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        humanoid:MoveTo(wp.Position)
        local start = tick()
        while (root.Position - wp.Position).Magnitude > 3 do
            if tick() - start > WAYPOINT_TIMEOUT then return false end
            task.wait(0.06)
        end
    end
    return true
end

local function findClickDetector(root)
    if not root then return nil end
    local stack = { root }
    while #stack > 0 do
        local n = table.remove(stack)
        for _, child in ipairs(n:GetChildren()) do
            if child:IsA("ClickDetector") then return child end
            stack[#stack+1] = child
        end
    end
    return nil
end

local function placeFlagIfNeeded(part)
    if not part or not part.Parent then return false end
    if hasFlagChild(part) then return false end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    if (root.Position - part.Position).Magnitude > FLAG_PLACE_RANGE then return false end
    local now = tick()
    if flaggedDebounce[part] and now - flaggedDebounce[part] < CLICK_DELAY then return false end
    local cd = findClickDetector(part)
    if cd then
        pcall(function() fireclickdetector(cd) end)
        flaggedDebounce[part] = now
        lastActionTime = now
        task.wait(CLICK_DELAY)
        return true
    end
    return false
end

local function removeFlagIfUnwanted(part)
    if not part or not part.Parent then return false end
    if not hasFlagChild(part) then return false end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    if (root.Position - part.Position).Magnitude > FLAG_PLACE_RANGE then return false end
    local now = tick()
    if flaggedDebounce[part] and now - flaggedDebounce[part] < CLICK_DELAY then return false end
    local cd = findClickDetector(part)
    if cd then
        pcall(function() fireclickdetector(cd) end)
        flaggedDebounce[part] = now
        lastActionTime = now
        task.wait(CLICK_DELAY)
        return true
    else
        for _, c in ipairs(part:GetChildren()) do
            if c.Name:sub(1,4) == "Flag" then pcall(function() c:Destroy() end) end
        end
        flaggedDebounce[part] = now
        lastActionTime = now
        task.wait(CLICK_DELAY)
        return true
    end
end

local function tryWalkToPart(targetPart)
    if not targetPart or not targetPart.Parent then return false end
    if tempBlocked[targetPart] and tick() < tempBlocked[targetPart] then return false end
    local char = player.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or isMoving then return false end

    local startPos = root.Position
    -- primary short-path
    local success, pathObj, length = computePath(startPos, targetPart.Position, WALK_MAX_PATH_LENGTH)
    if success and pathObj then
        isMoving = true
        local ok = followPathWaypoints(humanoid, root, pathObj)
        isMoving = false
        lastActionTime = tick()
        if ok and (root.Position - targetPart.Position).Magnitude <= ((targetPart.Size and math.max(targetPart.Size.X, targetPart.Size.Z) or 3) * 1.5) then
            return true
        else
            tempBlocked[targetPart] = tick() + TEMP_BLOCK_DURATION
            return false
        end
    end

    -- fallback full path check with length cap
    local okFull, fullPath, fullLen = computePath(startPos, targetPart.Position, nil)
    if okFull and fullPath and type(fullLen) == "number" and fullLen <= FALLBACK_MAX_PATH then
        isMoving = true
        local ok2 = followPathWaypoints(humanoid, root, fullPath)
        isMoving = false
        lastActionTime = tick()
        if ok2 and (root.Position - targetPart.Position).Magnitude <= ((targetPart.Size and math.max(targetPart.Size.X, targetPart.Size.Z) or 3) * 1.5) then
            return true
        else
            tempBlocked[targetPart] = tick() + TEMP_BLOCK_DURATION
            return false
        end
    end

    tempBlocked[targetPart] = tick() + TEMP_BLOCK_DURATION
    return false
end

--------------------------------------------------------------------------------
-- Integration loop: updateLogic (original), then actions (flagging/walking)
--------------------------------------------------------------------------------

local ENABLED = false

local function flaggedPartsFromLogic()
    local parts = {}
    for cellObj, _ in pairs(state.cells.toFlag or {}) do
        if cellObj and cellObj.part then parts[cellObj.part] = true end
    end
    return parts
end

local function safePartsFromLogic()
    local parts = {}
    for cellObj, _ in pairs(state.cells.toClear or {}) do
        if cellObj and cellObj.part then parts[cellObj.part] = true end
    end
    return parts
end

local function processSolverActions()
    if not ENABLED or isMoving then return end
    if tick() - lastActionTime < ACTION_COOLDOWN then return end

    local flagFolder = workspace:FindFirstChild("Flag")
    local partsFolder = flagFolder and flagFolder:FindFirstChild("Parts")
    if not partsFolder then return end
    local allParts = partsFolder:GetChildren()
    if #allParts == 0 then return end

    -- don't act if round starting (no revealed tiles)
    local hasRevealed = false
    for _, p in ipairs(allParts) do if isCellOpen(p) then hasRevealed = true; break end end
    if not hasRevealed then return end

    -- Desired flags from logic
    local desiredFlagParts = flaggedPartsFromLogic()

    -- 1) Place flags required by logic (within FLAG_PLACE_RANGE)
    for partWanted, _ in pairs(desiredFlagParts) do
        if partWanted and partWanted.Parent and not hasFlagChild(partWanted) then
            if placeFlagIfNeeded(partWanted) then
                removeBlockerFor(partWanted)
            end
        end
    end

    -- 2) Remove physical flags that solver doesn't want (within FLAG_PLACE_RANGE)
    for _, p in ipairs(allParts) do
        if hasFlagChild(p) and not desiredFlagParts[p] then
            removeFlagIfUnwanted(p)
        end
    end

    -- 3) Build allowPassParts (safe by logic + desired flags + processed)
    local allowPassParts = {}
    local safeParts = safePartsFromLogic()
    for p, _ in pairs(safeParts) do allowPassParts[p] = true end
    for p, _ in pairs(processedParts) do allowPassParts[p] = true end
    for p, _ in pairs(desiredFlagParts) do allowPassParts[p] = true end

    -- 4) Update blockers excluding allowPassParts
    updateBlockers(allowPassParts)

    -- 5) Walk to nearest safe tile (toClear)
    local candidates = {}
    for p, _ in pairs(safeParts) do
        if p and p.Parent and not processedParts[p] and not isCellOpen(p) and (not tempBlocked[p] or tick() >= tempBlocked[p]) then
            candidates[#candidates+1] = p
        end
    end

    if #candidates == 0 then return end

    -- sort by distance to player
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local playerPos = root and root.Position
    if playerPos then
        table.sort(candidates, function(a,b) return (a.Position - playerPos).Magnitude < (b.Position - playerPos).Magnitude end)
    end

    -- try walking to candidates until one succeeds
    for _, targetPart in ipairs(candidates) do
        if processedParts[targetPart] then
        else
            local walked = tryWalkToPart(targetPart)
            if walked then
                processedParts[targetPart] = true
                lastActionTime = tick()
                break
            else
                -- mark as temp blocked already done in tryWalkToPart
            end
        end
    end
end

--------------------------------------------------------------------------------
-- RunService: keep grid & logic updated then actions
--------------------------------------------------------------------------------

RunService.Heartbeat:Connect(function()
    local flagFolder = workspace:FindFirstChild("Flag")
    if not flagFolder then return end
    local partsFolder = flagFolder:FindFirstChild("Parts")
    if not partsFolder then return end

    local partCount = #partsFolder:GetChildren()
    local stateChanged = partCount ~= state.lastPartCount
    if stateChanged then
        state.lastPartCount = partCount
        rebuildGridFromParts(partsFolder)
        neighborCache = {}
        state.cells.toFlag = {}
        state.cells.toClear = {}
        processedParts = {}
        tempBlocked = {}
    end

    if state.grid.w == 0 or state.grid.h == 0 then return end

    updateCellStates(partsFolder)
    local currentNumberedCount = #state.cells.numbered
    if stateChanged or currentNumberedCount ~= state.lastNumberedCount then
        state.lastNumberedCount = currentNumberedCount
        updateLogic()
    end

    pcall(processSolverActions)
end)

-- Toggle key
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == TOGGLE_KEY then
        ENABLED = not ENABLED
        neighborCache = {}
        processedParts = {}
        tempBlocked = {}
        if not ENABLED then
            for k, v in pairs(blockersMap or {}) do if v and v.Parent then pcall(function() v:Destroy() end) end end
            blockersMap = {}
        end
        pcall(function() StarterGui:SetCore("ChatMakeSystemMessage", { Text = "[Solver] " .. (ENABLED and "ON" or "OFF"), Color = Color3.new(1,1,1) }) end)
    end
end)

-- reset on character spawn
if player then
    player.CharacterAdded:Connect(function(char)
        isMoving = false
        neighborCache = {}
        processedParts = {}
        tempBlocked = {}
    end)
end

