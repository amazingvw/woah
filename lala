local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- CONFIGURATION
local SETTINGS = {
    Enabled = false,
    AutoFlag = true,       -- Automatically place flags
    FlagRadius = 15,       -- Only flag mines within this distance (looks legit)
    WalkRadius = 40,       -- Max distance to search for a path
    PillarHeight = 20,     -- Height of invisible walls
    CalcDelay = 0.15,      -- Logic update speed
}

-- STATE
local player = Players.LocalPlayer
local neighborCache = {}
local blockers = {} 
local isMoving = false
local currentTarget = nil
local flagRemote = nil

-- FOLDER SETUP
local blockerFolder = workspace:FindFirstChild("SolverBlockers") or Instance.new("Folder")
blockerFolder.Name = "SolverBlockers"
blockerFolder.Parent = workspace

-- NOTIFICATION
local function notify(msg)
    game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
        Text = "[Solver]: " .. msg,
        Color = Color3.fromRGB(0, 255, 150),
        Font = Enum.Font.GothamBold
    })
end

-- ATTEMPT TO FIND FLAG REMOTE
local function getFlagRemote()
    if flagRemote then return flagRemote end
    local candidates = {"Flag", "FlagEvent", "PlaceFlag", "TileInteraction"}
    for _, name in ipairs(candidates) do
        local r = ReplicatedStorage:FindFirstChild(name)
        if r and r:IsA("RemoteEvent") then
            flagRemote = r
            return r
        end
    end
    return nil
end

-- HELPER: TILE STATUS
local function isCellOpen(part)
    if not part or not part.Parent then return true end
    local isBeige = (part.Color.R > 0.7 and part.Color.G > 0.7 and part.Color.B < 0.6)
    return part.Transparency > 0.5 or isBeige or part:FindFirstChild("NumberGui")
end

local function isFlagged(part)
    return part:FindFirstChild("Flag") or part:FindFirstChild("BombFlag") or part:FindFirstChild("FlagModel")
end

-- DATA SCRAPING
local function getGridData()
    local folder = workspace:FindFirstChild("Flag") and workspace.Flag:FindFirstChild("Parts")
    if not folder then return {} end
    
    local numberData = {}
    local allParts = folder:GetChildren()
    
    for _, cell in ipairs(allParts) do
        if isCellOpen(cell) then
            local label = cell:FindFirstChild("NumberGui") and cell.NumberGui:FindFirstChildOfClass("TextLabel")
            local val = (label and tonumber(label.Text)) or 0
            
            if not neighborCache[cell] then
                local nbs = {}
                for _, n in ipairs(allParts) do
                    if n ~= cell and (n.Position - cell.Position).Magnitude < (cell.Size.X * 1.8) then
                        table.insert(nbs, n)
                    end
                end
                neighborCache[cell] = nbs
            end
            
            local hidden, mines = {}, 0
            for _, n in ipairs(neighborCache[cell]) do
                if not isCellOpen(n) then
                    -- Consider it a mine if we marked it black OR it has a flag
                    if n.Color == Color3.new(0,0,0) or isFlagged(n) then
                        mines = mines + 1
                    else
                        table.insert(hidden, n)
                    end
                end
            end
            
            if #hidden > 0 or val == 0 then
                table.insert(numberData, {obj = cell, eVal = val - mines, hidden = hidden})
            end
        end
    end
    return numberData
end

-- SOLVER LOGIC (EULER)
local function calculate()
    local data = getGridData()
    local safeSet = {}
    local mineSet = {}
    
    -- 1. Simple Deduction
    for _, d in ipairs(data) do
        if d.eVal == 0 then
            for _, h in ipairs(d.hidden) do safeSet[h] = true end
        elseif d.eVal == #d.hidden then
            for _, h in ipairs(d.hidden) do mineSet[h] = true end
        end
    end
    
    -- 2. Set Intersection (The "Smart" Logic)
    for i = 1, #data do
        for j = 1, #data do
            if i ~= j then
                local d1, d2 = data[i], data[j]
                if (d1.obj.Position - d2.obj.Position).Magnitude < 12 then
                    local s1, s2 = d1.hidden, d2.hidden
                    local isSubset = true
                    for _, x in ipairs(s1) do
                        local found = false
                        for _, y in ipairs(s2) do if x == y then found = true break end end
                        if not found then isSubset = false break end
                    end
                    
                    if isSubset and #s2 > #s1 then
                        local diffMines = d2.eVal - d1.eVal
                        local diffList = {}
                        for _, x in ipairs(s2) do
                            local inS1 = false
                            for _, y in ipairs(s1) do if x == y then inS1 = true break end end
                            if not inS1 then table.insert(diffList, x) end
                        end
                        
                        if diffMines == 0 then
                            for _, x in ipairs(diffList) do safeSet[x] = true end
                        elseif diffMines == #diffList then
                            for _, x in ipairs(diffList) do mineSet[x] = true end
                        end
                    end
                end
            end
        end
    end
    
    return safeSet, mineSet
end

-- ACTION: HANDLE FLAGS
local function manageFlags(safeSet, mineSet)
    if not SETTINGS.AutoFlag then return end
    local remote = getFlagRemote()
    if not remote then return end
    
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- 1. Place Flags on Mines (within radius)
    for part, _ in pairs(mineSet) do
        if not isFlagged(part) then
            if (part.Position - root.Position).Magnitude <= SETTINGS.FlagRadius then
                remote:FireServer(part)
            end
        end
    end

    -- 2. Remove Wrong Flags (on Safe spots)
    for part, _ in pairs(safeSet) do
        if isFlagged(part) then
            if (part.Position - root.Position).Magnitude <= SETTINGS.FlagRadius then
                remote:FireServer(part) -- Toggling usually removes it
            end
        end
    end
end

-- MOVEMENT: UPDATE BLOCKERS
local function updateBlockers(safeSet, mineSet)
    local folder = workspace:FindFirstChild("Flag") and workspace.Flag:FindFirstChild("Parts")
    if not folder then return end
    
    for _, part in ipairs(folder:GetChildren()) do
        local isSafe = safeSet[part]
        local isRevealed = isCellOpen(part)
        local hasFlag = isFlagged(part)
        
        -- BLOCK IF: Hidden AND NOT Safe AND NOT Flagged
        -- (This means we allow walking on Safe tiles AND Flagged tiles)
        local shouldBlock = not isRevealed and not isSafe and not hasFlag
        
        if shouldBlock then
            if not blockers[part] then
                local b = Instance.new("Part")
                b.Name = "Blocker"
                b.Size = part.Size + Vector3.new(0, SETTINGS.PillarHeight, 0)
                b.Position = part.Position
                b.Transparency = 1
                b.Anchored = true
                b.CanCollide = true
                b.CanQuery = true -- Pathfinding sees this
                b.Parent = blockerFolder
                blockers[part] = b
            end
        else
            if blockers[part] then
                blockers[part]:Destroy()
                blockers[part] = nil
            end
        end
    end
end

-- MOVEMENT: PATHFINDING
local function walkTo(targetPart)
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    
    isMoving = true
    currentTarget = targetPart
    
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        WaypointSpacing = 4,
        Costs = {
            SmoothPlastic = 1 -- Prefer normal tiles
        }
    })
    
    local success = pcall(function()
        path:ComputeAsync(root.Position, targetPart.Position)
    end)
    
    if success and path.Status == Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do
            if not SETTINGS.Enabled or currentTarget ~= targetPart then break end
            
            if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
            hum:MoveTo(wp.Position)
            
            -- Wait for arrival with timeout
            local moveSuccess = hum.MoveToFinished:Wait()
            if not moveSuccess then break end
        end
    else
        -- Fallback for short distances
        if (targetPart.Position - root.Position).Magnitude < 10 then
            hum:MoveTo(targetPart.Position)
        end
    end
    
    isMoving = false
    currentTarget = nil
end

-- MAIN LOOP
task.spawn(function()
    while true do
        if SETTINGS.Enabled then
            local safeSet, mineSet = calculate()
            
            manageFlags(safeSet, mineSet)
            updateBlockers(safeSet, mineSet)
            
            -- Visuals for Mines
            for m, _ in pairs(mineSet) do 
                if (m.Position - player.Character.HumanoidRootPart.Position).Magnitude < SETTINGS.FlagRadius + 5 then
                    m.Color = Color3.new(0,0,0) 
                end
            end

            -- Auto Walk Logic
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if root and not isMoving then
                local closest = nil
                local minDst = math.huge
                
                for part, _ in pairs(safeSet) do
                    if not isCellOpen(part) then
                        local dst = (part.Position - root.Position).Magnitude
                        -- Only target if reasonably close to prevent cross-map pathing
                        if dst < minDst and dst < SETTINGS.WalkRadius then
                            minDst = dst
                            closest = part
                        end
                    end
                end
                
                if closest then
                    walkTo(closest)
                end
            end
        end
        task.wait(SETTINGS.CalcDelay)
    end
end)

-- CONTROLS
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.U then
        SETTINGS.Enabled = not SETTINGS.Enabled
        if not SETTINGS.Enabled then
            blockerFolder:ClearAllChildren()
            blockers = {}
            isMoving = false
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid:MoveTo(char.HumanoidRootPart.Position) -- Stop moving
            end
        end
        notify(SETTINGS.Enabled and "Enabled" or "Disabled")
    end
end)

notify("Walking Solver v3 Loaded. Press 'U' to start.")
