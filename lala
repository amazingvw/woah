ll be that first returned value; we need to call directly
                        local s, len = pathIsWalkable(playerPos, target.Position, WALK_MAX_PATH_LENGTH)
                        if s then canWalk = true end
                    else
                        -- fallback: no path info — do not walk
                        canWalk = false
                    end
                end

                -- After checking with allowSet, restore pillars to block everything (so other checks are correct)
                if partsFolder then updatePillars(partsFolder, nil) end

                if canWalk then
                    local walkedOK = safeWalkTo(target)
                    if walkedOK then
                        processedParts[target] = true
                        acted = true
                        break -- done one action this tick
                    else
                        -- fallback to teleport if walk failed
                        local teleOK = teleportTo(target)
                        if teleOK then
                            processedParts[target] = true
                            acted = true
                            break
                        end
                    end
                else
                    -- not walkable: teleport directly
                    local teleOK = teleportTo(target)
                    if teleOK then
                        processedParts[target] = true
                        acted = true
                        break
                    end
                end
            end
        end

        if acted then
            -- no extra delay, but let the next loop see board updates
        end

    elseif not foundAnything then
        -- Nothing logically safe found: gamble by teleporting to a random covered tile
        local flagFolder = workspace:FindFirstChild("Flag")
        local partsFolder2 = flagFolder and flagFolder:FindFirstChild("Parts")
        if partsFolder2 then
            local allParts = partsFolder2:GetChildren()
            local candidates = {}
            for _, p in ipairs(allParts) do
                if not isCellOpen(p) and not processedParts[p] then
                    table.insert(candidates, p)
                end
            end
            if #candidates > 0 then
                local pick = candidates[math.random(#candidates)]
                if pick then
                    -- allow pick while path-checking (though we're teleporting)
                    if partsFolder2 then updatePillars(partsFolder2, nil) end
                    teleportTo(pick)
                    processedParts[pick] = true
                end
            end
        end
    end
end

-- PERSISTENCE & TOGGLE
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == TOGGLE_KEY then
        ENABLED = not ENABLED
        neighborCache = {}
        processedParts = {}
        -- when toggling on, rebuild pillars to match current board
        local ff = workspace:FindFirstChild("Flag")
        local partsFolder = ff and ff:FindFirstChild("Parts")
        if partsFolder then updatePillars(partsFolder, nil) end
        chatNotify("Solver " .. (ENABLED and "ON" or "OFF"))
    end
end)

