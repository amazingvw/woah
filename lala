-- Original grid + cell state code (preserved)
--------------------------------------------------------------------------------

local function clusterAndAverage(values, maxDiff)
    local clusters = {}
    local n = #values
    if n == 0 then return clusters end

    local current = values[1]
    local count = 1

    for i = 2, n do
        local v = values[i]
        if abs(v - current) <= maxDiff then
            count = count + 1
            current = current + (v - current) / count
        else
            table.insert(clusters, current)
            current = v
            count = 1
        end
    end

    table.insert(clusters, current)
    return clusters
end

local function median(values)
    local n = #values
    if n == 0 then return nil end
    tsort(values)
    return values[floor((n + 1) / 2)]
end

local function estimateSpacing(coords)
    if #coords < 3 then return 4 end
    local diffs = {}
    for i = 2, #coords do
        diffs[#diffs + 1] = abs(coords[i] - coords[i-1])
    end
    return median(diffs) or 4
end

local function findClosestIndex(target, sorted)
    local bestIdx = 1
    local bestDist = huge
    for i = 1, #sorted do
        local dist = abs(target - sorted[i])
        if dist < bestDist then
            bestDist = dist
            bestIdx = i
        end
    end
    return bestIdx - 1
end

local function rebuildGridFromParts(folder)
    -- Rebuild grid exactly as your original did
    state.cells.grid = {}
    state.grid.w = 0
    state.grid.h = 0

    local parts = folder:GetChildren()
    if #parts == 0 then return end

    local allPositions = {}
    local sumY = 0
    for _, part in ipairs(parts) do
        local pos = part.Position
        table.insert(allPositions, { part = part, pos = pos })
        sumY = sumY + pos.Y
    end

    local xs, zs = {}, {}
    for _, d in ipairs(allPositions) do
        xs[#xs + 1] = d.pos.X
        zs[#zs + 1] = d.pos.Z
    end
    tsort(xs); tsort(zs)

    local cellWidth = estimateSpacing(xs) * 0.6
    local cellHeight = estimateSpacing(zs) * 0.6

    local uniqueX = clusterAndAverage(xs, cellWidth)
    local uniqueZ = clusterAndAverage(zs, cellHeight)

    state.grid.w = #uniqueX
    state.grid.h = #uniqueZ
    if state.grid.w == 0 or state.grid.h == 0 then return end

    local avgY = sumY / #parts

    for x = 0, state.grid.w - 1 do
        state.cells.grid[x] = {}
        for z = 0, state.grid.h - 1 do
            state.cells.grid[x][z] = {
                ix = x,
                iz = z,
                pos = Vector3.new(uniqueX[x+1], avgY, uniqueZ[z+1]),
                part = nil,
                state = "unknown",
                number = nil,
                covered = true,
                neigh = nil
            }
        end
    end

    for _, data in ipairs(allPositions) do
        local pos = data.pos
        local part = data.part
        local xIdx = findClosestIndex(pos.X, uniqueX)
        local zIdx = findClosestIndex(pos.Z, uniqueZ)
        local cell = state.cells.grid[xIdx][zIdx]
        if not cell.part then
            cell.part = part
            cell.pos = pos
        else
            local currDist = (cell.part.Position - Vector3.new(uniqueX[xIdx+1], cell.part.Position.Y, uniqueZ[zIdx+1])).Magnitude
            local newDist = (pos - Vector3.new(uniqueX[xIdx+1], pos.Y, uniqueZ[zIdx+1])).Magnitude
            if newDist < currDist then
                cell.part = part
                cell.pos = pos
            end
        end
    end

    for z = 0, state.grid.h - 1 do
        for x = 0, state.grid.w - 1 do
            local cell = state.cells.grid[x][z]
            local neighbors = {}
            for dz = -1, 1 do
                for dx = -1, 1 do
                    if not (dx == 0 and dz == 0) then
                        local nx, nz = x + dx, z + dz
                        if nx >= 0 and nx < state.grid.w and nz >= 0 and nz < state.grid.h then
                            neighbors[#neighbors + 1] = state.cells.grid[nx][nz]
                        end
                    end
                end
            end
            cell.neigh = neighbors
        end
    end
end

local function updateCellStates(folder)
    state.cells.numbered = {}
    if state.grid.w == 0 then return end

    for x = 0, state.grid.w - 1 do
        local column = state.cells.grid[x]
        if column then
            for z = 0, state.grid.h - 1 do
                local cell = column[z]
                if cell and cell.part then
                    cell.state = "unknown"
                    cell.number = nil
                    cell.covered = true
                    cell.color = nil

                    local partColor = cell.part.Color
                    if partColor then
                        local r = (partColor.R <= 1) and floor(partColor.R * 255 + 0.5) or partColor.R
                        local g = (partColor.G <= 1) and floor(partColor.G * 255 + 0.5) or partColor.G
                        local b = (partColor.B <= 1) and floor(partColor.B * 255 + 0.5) or partColor.B
                        cell.color = {R = r, G = g, B = b}
                    end

                    local numberGui = cell.part:FindFirstChild("NumberGui")
                    if numberGui then
                        local label = numberGui:FindFirstChild("TextLabel")
                        if label and isNumber(label.Text) then
                            cell.number = tonumber(label.Text)
                            cell.covered = false
                        end
                    end

                    local color = cell.color
                    local hasGui = cell.part:FindFirstChild("NumberGui") ~= nil
                    local isRevealed = hasGui
                    if color and not hasGui then
                        local r = math.floor(color.R * 255 + 0.5)
                        local g = math.floor(color.G * 255 + 0.5)
                        local b = math.floor(color.B * 255 + 0.5)
                        if r >= 180 and g >= 180 and b >= 180 
                        and math.abs(r - g) <= 50 
                        and math.abs(g - b) <= 50 
                        and math.abs(r - b) <= 50 then
                            isRevealed = true
                        end
                    end

                    if isRevealed then cell.covered = false end
                    if hasFlagChild(cell.part) then cell.state = "flagged" end
                    if cell.number and not cell.covered then
                        cell.state = "number"
                        state.cells.numbered[#state.cells.numbered + 1] = cell
                    end
                end
            end
        end
    end
end

--------------------------------------------------------------------------------
-- Original deduction logic (unchanged, copied from your original)
--------------------------------------------------------------------------------

local function getUnknownNeighborsExcluding(cell, flaggedSet, safeSet)
    local result = {}
    for _, n in ipairs(cell.neigh) do
        if not flaggedSet[n] and not safeSet[n] and not (n.state == "number" or n.state == "flagged") and n.covered ~= false then
            result[#result + 1] = n
        end
    end
    return result
end

local function countRemainingMines(cell, flaggedSet)
    local remaining = cell.number or 0
    for _, n in ipairs(cell.neigh) do
        if flaggedSet[n] or n.state == "flagged" then
            remaining = remaining - 1
        end
    end
    return remaining
end

local function applySimpleDeductionRule(cellA, cellB, unknownsA, unknownsB, flaggedSet, safeSet)
    local intersection = {}
    local onlyA = {}
    local onlyB = {}

    local setA = {}
    for _, u in ipairs(unknownsA) do setA[u] = true end

    for _, u in ipairs(unknownsB) do
        if setA[u] then
            intersection[#intersection + 1] = u
            setA[u] = nil
        else
            onlyB[#onlyB + 1] = u
        end
    end

    for u in pairs(setA) do
        onlyA[#onlyA + 1] = u
    end

    local minesA = countRemainingMines(cellA, flaggedSet)
    local minesB = countRemainingMines(cellB, flaggedSet)

    if #onlyA == 0 and #onlyB > 0 then
        local diff = minesB - minesA
        if diff == 0 then
            for _, u in ipairs(onlyB) do safeSet[u] = true end
        elseif diff == #onlyB then
            for _, u in ipairs(onlyB) do flaggedSet[u] = true end
        end
    end

    if #onlyB == 0 and #onlyA > 0 then
        local diff = minesA - minesB
        if diff == 0 then
            for _, u in ipairs(onlyA) do safeSet[u] = true end
        elseif diff == #onlyA then
            for _, u in ipairs(onlyA) do flaggedSet[u] = true end
        end
    end
end

local function checkAdjacentNumberedCells(flaggedSet, safeSet)
    local numbered = state.cells.numbered
    local grid = state.cells.grid

    for _, cell in ipairs(numbered) do
        for dz = -1, 1 do
            for dx = -1, 1 do
                if not (dx == 0 and dz == 0) then
                    local nx = cell.ix + dx
                    local nz = cell.iz + dz
                    if nx >= 0 and nx < state.grid.w and nz >= 0 and nz < state.grid.h then
                        local adj = grid[nx][nz]
                        if adj and adj.state == "number" then
                            local unknownsThis = getUnknownNeighborsExcluding(cell, flaggedSet, safeSet)
                            local unknownsAdj = getUnknownNeighborsExcluding(adj, flaggedSet, safeSet)
                            if #unknownsThis > 0 and #unknownsAdj > 0 then
                                applySimpleDeductionRule(cell, adj, unknownsThis, unknownsAdj, flaggedSet, safeSet)
                            end
                        end
                    end
                end
            end
        end
    end
end

local function updateLogic()
    if state.grid.w == 0 then
        state.cells.toFlag = {}
        state.cells.toClear = {}
        return
    end

    local numbered = state.cells.numbered
    if #numbered == 0 then
        state.cells.toFlag = {}
        state.cells.toClear = {}
        return
    end

    local knownFlags = {}
    for x = 0, state.grid.w - 1 do
        local col = state.cells.grid[x]
        if col then
            for z = 0, state.grid.h - 1 do
                local cell = col[z]
                if cell and cell.state == "flagged" then
                    knownFlags[cell] = true
                end
            end
        end
    end

    local changed = true
    local iterations = 0
    while changed and iterations < 64 do
        changed = false
        iterations = iterations + 1

        for _, cell in ipairs(numbered) do
            local unknowns = {}
            local flagCount = 0

            for _, n in ipairs(cell.neigh) do
                if knownFlags[n] or n.state == "flagged" then
                    flagCount = flagCount + 1
                elseif not state.cells.toClear[n] and (not (n.state == "number" or n.state == "flagged") and n.covered ~= false) then
                    unknowns[#unknowns + 1] = n
                end
            end

            local remaining = (cell.number or 0) - flagCount

            if remaining > 0 and remaining == #unknowns then
                for _, u in ipairs(unknowns) do
                    if not knownFlags[u] then
                        knownFlags[u] = true
                        changed = true
                    end
                end
            elseif remaining == 0 and #unknowns > 0 then
                for _, u in ipairs(unknowns) do
                    if not state.cells.toClear[u] then
                        state.cells.toClear[u] = true
                        changed = true
                    end
                end
            end
        end

        checkAdjacentNumberedCells(knownFlags, state.cells.toClear)
    end

    state.cells.toFlag = knownFlags
end

--------------------------------------------------------------------------------
-- Pathfinding + movement (walk-only)
--------------------------------------------------------------------------------

local processedParts = {} -- part -> true (visited)
local blockersMap = {}    -- part -> blocker part
local blockerFolder = workspace:FindFirstChild("SolverBlockers")
if not blockerFolder then
    blockerFolder = Instance.new("Folder")
    blockerFolder.Name = "SolverBlockers"
    blockerFolder.Parent = workspace
end

local flaggedDebounce = {} -- part -> last time we clicked for flag

local function ensureBlockerFor(part)
    if not part or not part.Parent then return end
    if blockersMap[part] and blockersMap[part].Parent then return end
    if hasFlagChild(part) then return end -- flagged tiles are walkable

    local b = Instance.new("Part")
    b.Name = "SolverBlocker"
    b.Size = PILLAR_SIZE
    b.Anchored = true
    b.CanCollide = true
    b.CanQuery = false
    b.CanTouch = false
    b.CastShadow = false
    b.Transparency = 1
    b.Material = Enum.Material.SmoothPlastic
    b.CFrame = CFrame.new(part.Position.X, part.Position.Y + (PILLAR_SIZE.Y/2), part.Position.Z)
    b.Parent = blockerFolder
    blockersMap[part] = b
end

local function removeBlockerFor(part)
    local b = blockersMap[part]
    if b and b.Parent then
        pcall(function() b:Destroy() end)
    end
    blockersMap[part] = nil
end

local function updateBlockers(allowPassParts)
    local folder = workspace:FindFirstChild("Flag")
    local partsFolder = folder and folder:FindFirstChild("Parts")
    if not partsFolder then
        for k, v in pairs(blockersMap) do if v and v.Parent then pcall(function() v:Destroy() end) end end
        blockersMap = {}
        return
    end

    local keep = {}
    local allParts = partsFolder:GetChildren()
    for _, p in ipairs(allParts) do
        if not p or not p.Parent then
        else
            local covered = not isCellOpen(p)
            local ok, col = pcall(function() return p.Color end)
            local isMarkedMine = ok and col and col == Color3.new(0,0,0)
            local allowed = false
            if allowPassParts and allowPassParts[p] then allowed = true end
            if processedParts[p] then allowed = true end
            if hasFlagChild(p) then allowed = true end
            if (covered or isMarkedMine) and not allowed then
                ensureBlockerFor(p)
                keep[p] = true
            end
        end
    end

    for partRef, _ in pairs(blockersMap) do
        if not keep[partRef] then
            removeBlockerFor(partRef)
        end
    end
end

-- path helper
local function computePath(startPos, endPos, maxLen)
    local ok, pathObj = pcall(function()
        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
        path:ComputeAsync(startPos, endPos)
        return path
    end)
    if not ok or not pathObj then return false, nil, nil end
    if pathObj.Status ~= Enum.PathStatus.Success then return false, pathObj, nil end
    local wps = pathObj:GetWaypoints()
    local len = 0
    for i = 2, #wps do len = len + (wps[i].Position - wps[i-1].Position).Magnitude end
    if maxLen and len > maxLen then return false, pathObj, len end
    return true, pathObj, len
end

local function followPathWaypoints(humanoid, root, path)
    if not path or not humanoid or not root then return false end
    local wps = path:GetWaypoints()
    if not wps or #wps == 0 then return false end
    for _, wp in ipairs(wps) do
        if wp.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        humanoid:MoveTo(wp.Position)
        local start = tick()
        while (root.Position - wp.Position).Magnitude > 3 do
            if tick() - start > WAYPOINT_TIMEOUT then return false end
            task.wait(0.06)
        end
    end
    return true
end

-- find clickdetector in part descendants
local function findClickDetector(root)
    if not root then return nil end
    -- depth-first
    local stack = { root }
    while #stack > 0 do
        local n = table.remove(stack)
        for _, child in ipairs(n:GetChildren()) do
            if child:IsA("ClickDetector") then return child end
            table.insert(stack, child)
        end
    end
    return nil
end

local function placeFlagIfNeeded(part)
    if not part or not part.Parent then return end
    if hasFlagChild(part) then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if (root.Position - part.Position).Magnitude > FLAG_PLACE_RANGE then return end
    local now = tick()
    if flaggedDebounce[part] and now - flaggedDebounce[part] < 0.8 then return end
    local cd = findClickDetector(part)
    if cd then
        pcall(function() fireclickdetector(cd) end)
        flaggedDebounce[part] = now
    end
end

local function removeFlagIfUnwanted(part)
    if not part or not part.Parent then return end
    if not hasFlagChild(part) then return end
    -- if solver does not want this flagged (not in state.cells.toFlag), and player is near, unflag
    -- we will check caller ensures this is unwanted
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if (root.Position - part.Position).Magnitude > FLAG_PLACE_RANGE then return end
    local now = tick()
    if flaggedDebounce[part] and now - flaggedDebounce[part] < 0.8 then return end
    local cd = findClickDetector(part)
    if cd then
        pcall(function() fireclickdetector(cd) end)
        flaggedDebounce[part] = now
    else
        -- fallback: try to remove child named "Flag" if placed by script (best-effort, non-invasive)
        for _, c in ipairs(part:GetChildren()) do
            if c.Name:sub(1,4) == "Flag" then
                pcall(function() c:Destroy() end)
            end
        end
    end
end

-- walker attempt to reach part via path
local function tryWalkToPart(targetPart)
    if not targetPart or not targetPart.Parent then return false end
    local char = player.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or isMoving then return false end

    local startPos = root.Position
    local success, pathObj, length = computePath(startPos, targetPart.Position, WALK_MAX_PATH_LENGTH)
    if not success or not pathObj then return false end

    isMoving = true
    local ok = followPathWaypoints(humanoid, root, pathObj)
    task.wait(ACTION_DELAY)
    isMoving = false
    if ok and (root.Position - targetPart.Position).Magnitude <= ((targetPart.Size and math.max(targetPart.Size.X, targetPart.Size.Z) or 3) * 1.5) then
        return true
    else
        return false
    end
end

--------------------------------------------------------------------------------
-- Main loop - integrates original solver logic + walking & flagging
--------------------------------------------------------------------------------

local ENABLED = false

-- Helper: convert state.cells.toFlag (map of cell objects) to set of parts
local function flaggedPartsFromLogic()
    local parts = {}
    for cellObj, _ in pairs(state.cells.toFlag or {}) do
        if cellObj and cellObj.part then parts[cellObj.part] = true end
    end
    return parts
end

-- Helper: convert state.cells.toClear (set of cell objects) to set of parts
local function safePartsFromLogic()
    local parts = {}
    for cellObj, _ in pairs(state.cells.toClear or {}) do
        if cellObj and cellObj.part then parts[cellObj.part] = true end
    end
    return parts
end

-- main processing function to run every tick / heartbeat
local function processSolverActions()
    if not ENABLED or isMoving then return end

    local flagFolder = workspace:FindFirstChild("Flag")
    local partsFolder = flagFolder and flagFolder:FindFirstChild("Parts")
    if not partsFolder then return end

    local allParts = partsFolder:GetChildren()
    if #allParts == 0 then return end

    -- if no revealed tiles, do not act (round starting)
    local hasRevealed = false
    for _, p in ipairs(allParts) do
        if isCellOpen(p) then hasRevealed = true; break end
    end
    if not hasRevealed then return end

    -- Build logic (these functions are updated elsewhere via Heartbeat)
    -- At this point state.cells.toFlag and toClear are up-to-date in RunService loop

    -- 1) Place flags for logic-suggested mines (but only within FLAG_PLACE_RANGE)
    local desiredFlagParts = flaggedPartsFromLogic()
    for partWanted, _ in pairs(desiredFlagParts) do
        -- if not physically flagged, place flag (if in range)
        if partWanted and partWanted.Parent and not hasFlagChild(partWanted) then
            placeFlagIfNeeded(partWanted)
            removeBlockerFor(partWanted) -- ensure pillar removed if we flagged it
        end
    end

    -- 2) Remove wrongly placed flags (physical flags that are NOT in desiredFlagParts)
    for _, p in ipairs(allParts) do
        if hasFlagChild(p) and not desiredFlagParts[p] then
            -- only attempt removal if within range (so we don't weirdly unflag distant ones)
            removeFlagIfUnwanted(p)
        end
    end

    -- 3) Recompute allowPassParts (parts we should NOT block): solver-safe + flagged + processed
    local allowPassParts = {}
    local safeParts = safePartsFromLogic()
    for p, _ in pairs(safeParts) do allowPassParts[p] = true end
    for p, _ in pairs(processedParts) do allowPassParts[p] = true end
    -- also allow pass on physically flagged tiles
    for _, p in ipairs(allParts) do if hasFlagChild(p) then allowPassParts[p] = true end end

    -- 4) Update blockers according to allowPassParts (this prevents pathfinder crossing unknowns/mines)
    updateBlockers(allowPassParts)

    -- 5) Walk: attempt to walk to nearest solver-safe tile (toClear)
    -- Build list of candidate safe parts (still covered)
    local candidates = {}
    for part, _ in pairs(safeParts) do
        if part and part.Parent and not processedParts[part] and not isCellOpen(part) then
            candidates[#candidates + 1] = part
        end
    end

    if #candidates == 0 then return end

    -- sort by distance to player if possible
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local playerPos = root and root.Position
    if playerPos then
        table.sort(candidates, function(a,b)
            return (a.Position - playerPos).Magnitude < (b.Position - playerPos).Magnitude
        end)
    end

    -- Attempt walking to each candidate until one succeeds
    for _, targetPart in ipairs(candidates) do
        if processedParts[targetPart] then
            -- skip
        else
            local walked = tryWalkToPart(targetPart)
            if walked then
                processedParts[targetPart] = true
                -- optional: if the solved tile should be recolored or otherwise marked, do it here
                break
            else
                -- cannot walk to this candidate (blocked or unreachable) — try next
            end
        end
    end
end

--------------------------------------------------------------------------------
-- RunService loop: keep grid & logic updated (from original)
--------------------------------------------------------------------------------

RunService.Heartbeat:Connect(function()
    local flagFolder = workspace:FindFirstChild("Flag")
    if not flagFolder then return end
    local partsFolder = flagFolder:FindFirstChild("Parts")
    if not partsFolder then return end

    local partCount = #partsFolder:GetChildren()
    local stateChanged = partCount ~= state.lastPartCount
    if stateChanged then
        state.lastPartCount = partCount
        rebuildGridFromParts(partsFolder)
        neighborCache = {} -- flush neighbor cache on new board
        state.cells.toFlag = {}
        state.cells.toClear = {}
        processedParts = {}
    end

    if state.grid.w == 0 or state.grid.h == 0 then return end

    -- update cell states from parts
    updateCellStates(partsFolder)

    local currentNumberedCount = #state.cells.numbered
    if stateChanged or currentNumberedCount ~= state.lastNumberedCount then
        state.lastNumberedCount = currentNumberedCount
        updateLogic()
    end

    -- now attempt movement / flagging (walk-only)
    pcall(processSolverActions)
end)

-- Toggle key
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == TOGGLE_KEY then
        ENABLED = not ENABLED
        neighborCache = {}
        processedParts = {}
        -- clear blockers when disabled
        if not ENABLED then
            for k, v in pairs(blockersMap) do if v and v.Parent then pcall(function() v:Destroy() end) end end
            blockersMap = {}
        end
