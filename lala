-- SAFE WALK + TELEPORT MINESWEEPER SOLVER (STABLE VERSION)

-- SETTINGS
local ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.U
local ACTION_DELAY = 0
local WALK_MAX_PATH_LENGTH = 35

local player = game.Players.LocalPlayer
local PathfindingService = game:GetService("PathfindingService")
local UserInputService = game:GetService("UserInputService")

-- STATE
local neighborCache = {}
local isMoving = false
local processed = {}
local blockers = {}

-- BLOCKER FOLDER
local blockerFolder = workspace:FindFirstChild("SolverBlockers") or Instance.new("Folder", workspace)
blockerFolder.Name = "SolverBlockers"

-- UTIL
local function chat(msg)
    pcall(function()
        game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
            Text = "[Solver] " .. msg,
            Color = Color3.new(1,1,1)
        })
    end)
end

local function isCellOpen(p)
    if not p or not p.Parent then return true end
    if p:FindFirstChild("NumberGui") then return true end
    local c = p.Color
    return p.Transparency > 0.5 or (c.R > 0.7 and c.G > 0.7 and c.B < 0.6)
end

-- BLOCKERS (ONLY DEFINITELY UNSAFE)
local function updateBlockers(unsafeSet)
    local parts = workspace.Flag.Parts:GetChildren()

    for _, p in ipairs(parts) do
        local unsafe = unsafeSet[p]
        if unsafe then
            if not blockers[p] then
                local b = Instance.new("Part")
                b.Size = Vector3.new(6, 100, 6)
                b.Anchored = true
                b.CanCollide = true
                b.Transparency = 1
                b.CFrame = p.CFrame * CFrame.new(0, 50, 0)
                b.Parent = blockerFolder
                blockers[p] = b
            end
        else
            if blockers[p] then
                blockers[p]:Destroy()
                blockers[p] = nil
            end
        end
    end
end

-- PATH CHECK (STRICT)
local function canSafelyWalk(from, to)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true
    })

    path:ComputeAsync(from, to)
    if path.Status ~= Enum.PathStatus.Success then return false end

    local len = 0
    local wp = path:GetWaypoints()
    for i = 2, #wp do
        len += (wp[i].Position - wp[i-1].Position).Magnitude
    end

    return len <= WALK_MAX_PATH_LENGTH
end

-- MOVE
local function walkTo(part)
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end

    isMoving = true
    hum:MoveTo(part.Position)
    hum.MoveToFinished:Wait()
    isMoving = false

    return (root.Position - part.Position).Magnitude < 4
end

local function teleportTo(part)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.CFrame = part.CFrame * CFrame.new(0, part.Size.Y/2 + 2, 0)
end

-- SOLVER
local function runSolver()
    if not ENABLED or isMoving then return end

    local parts = workspace.Flag.Parts:GetChildren()
    local safeTiles = {}
    local unsafeTiles = {}

    -- BASIC RULES
    for _, p in ipairs(parts) do
        if p.Color == Color3.new(0,0,0) then
            unsafeTiles[p] = true
        elseif isCellOpen(p) then
            processed[p] = true
        end
    end

    -- SIMPLE SAFE DISCOVERY
    for _, p in ipairs(parts) do
        if isCellOpen(p) and p:FindFirstChild("NumberGui") then
            local num = tonumber(p.NumberGui.TextLabel.Text)
            if num == 0 then
                for _, n in ipairs(parts) do
                    if (n.Position - p.Position).Magnitude < 7 and not isCellOpen(n) then
                        safeTiles[n] = true
                    end
                end
            end
        end
    end

    updateBlockers(unsafeTiles)

    -- ACT
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for tile in pairs(safeTiles) do
        if not processed[tile] then
            if canSafelyWalk(root.Position, tile.Position) then
                if walkTo(tile) then
                    processed[tile] = true
                    return
                end
            else
                teleportTo(tile)
                processed[tile] = true
                return
            end
        end
    end
end

-- TOGGLE
UserInputService.InputBegan:Connect(function(i,g)
    if g then return end
    if i.KeyCode == TOGGLE_KEY then
        ENABLED = not ENABLED
        processed = {}
        chat(ENABLED and "ON" or "OFF")
    end
end)

-- LOOP
task.spawn(function()
    while true do
        pcall(runSolver)
        task.wait(0.05)
    end
end)

chat("Solver loaded. Press U.")
