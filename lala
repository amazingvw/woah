-- Walk-only Minesweeper solver (based on your original logic)
-- Features:
--  - preserves original deduction logic (toFlag / toClear)
--  - places flags via ClickDetector within FLAG_PLACE_RANGE
--  - removes physical flags that solver disagrees with (within range)
--  - uses blockers to prevent pathfinder crossing unknown/mined tiles, but excludes solver-safe or flagged tiles
--  - WALK ONLY (no teleport)
--  - follows path waypoints robustly
-- Toggle with U (TOGGLE_KEY)

-- =============== TUNABLES =================
local TOGGLE_KEY = Enum.KeyCode.U
local ACTION_DELAY = 0          -- pause after arriving on tile
local WALK_MAX_PATH_LENGTH = 40 -- max allowed path length (studs)
local WAYPOINT_TIMEOUT = 2      -- seconds allowed to reach each waypoint
local PILLAR_SIZE = Vector3.new(6, 100, 6)
local FLAG_PLACE_RANGE = 10     -- only place/remove flags within this radius
local PATH_CHECK_RETRIES = 1    -- how many fallback attempts for path compute
-- ==========================================

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer

-- Keep original solver state & helpers (copied / adapted from your original)
local config = {
    TotalMines = 20,
    DistanceWeight = 0.1,
    EdgePenalty = 0.05,
    Debug = false
}

local state = {
    cells = {
        grid = {},
        numbered = {},
        toFlag = {},
        toClear = {}
    },
    grid = { w = 0, h = 0 },
    lastPartCount = -1,
    lastNumberedCount = 0
}

local abs, floor, huge = math.abs, math.floor, math.huge
local tsort = table.sort

local neighborCache = {}

local function isNumber(str) return tonumber(str) ~= nil end

-- Minimal helper used from original
local function hasFlagChild(parent)
    for _, child in ipairs(parent:GetChildren()) do
        if child.Name:sub(1,4) == "Flag" then return true end
    end
    return false
end

local function isCellOpen(part)
    if not part or not part.Parent then return true end
    local ok, c = pcall(function() return part.Color end)
    if not ok or not c then return true end
    local isBeige = (c.R > 0.7 and c.G > 0.7 and c.B < 0.6)
    return (part.Transparency and part.Transparency > 0.5) or isBeige or (part:FindFirstChild("NumberGui") ~= nil)
end

