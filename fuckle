-- MAIN BUTTONS LOGIC
---------------------------------------------------------
local buttonData = {
	{Name = "Emote", ImageId = "rbxassetid://91728455268947", DefaultPos = UDim2.new(0.5, -60, 0.5, 0)},
	{Name = "Macro", ImageId = "rbxassetid://115106483868384", DefaultPos = UDim2.new(0.5, 60, 0.5, 0)}
}

for _, data in pairs(buttonData) do
	local ImageButton = Instance.new("ImageButton")
	ImageButton.Name, ImageButton.Parent, ImageButton.AnchorPoint, ImageButton.Position, ImageButton.Size = data.Name, ScreenGui, Vector2.new(0.5, 0.5), data.DefaultPos, UDim2.new(0, 50, 0, 50)
	ImageButton.BackgroundTransparency, ImageButton.Image, ImageButton.ImageTransparency, ImageButton.ZIndex = 1, data.ImageId, 0.5, 2
	ImageButton:SetAttribute("IsActive", false)
	Instance.new("UICorner", ImageButton).CornerRadius = UDim.new(1, 0)

	local InnerStroke = Instance.new("UIStroke", ImageButton)
	InnerStroke.Thickness, InnerStroke.Color, InnerStroke.Transparency = 3, Color3.fromRGB(255, 255, 255), 0.75
	
	local OuterFrame = Instance.new("Frame", ImageButton)
	OuterFrame.AnchorPoint, OuterFrame.Position, OuterFrame.Size, OuterFrame.BackgroundTransparency, OuterFrame.ZIndex = Vector2.new(0.5, 0.5), UDim2.new(0.5, 0, 0.5, 0), UDim2.new(1, 6, 1, 6), 1, 1
	local OuterStroke = Instance.new("UIStroke", OuterFrame)
	OuterStroke.Thickness, OuterStroke.Color, OuterStroke.Transparency = 3, Color3.fromRGB(0, 0, 0), 0.5
	Instance.new("UICorner", OuterFrame).CornerRadius = UDim.new(1, 0)

	local spring, targetPosition, isDragging, dragOffset = {pos = 1, vel = 0, target = 1}, data.DefaultPos, false, Vector2.new()

	ImageButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if isConfigMode then
				isDragging = true
				dragOffset = Vector2.new(input.Position.X - ImageButton.AbsolutePosition.X, input.Position.Y - ImageButton.AbsolutePosition.Y)
				spring.target = 1.2
			else spring.target = 0.75 end
		end
	end)

	ImageButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging, spring.target = false, 1
			if not isConfigMode then
				if data.Name == "Emote" then
					-- PERSISTENCE: Get the LATEST character on every click
					local char = localPlayer.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local desc = hum and hum:FindFirstChildOfClass("HumanoidDescription")
					if desc then
						local emotes = desc:GetEmotes()
						emotes["Macro"] = {117301403779781}
						desc:SetEmotes(emotes)
						pcall(function() hum:PlayEmote("Macro") end)
					end
				elseif data.Name == "Macro" then
					ImageButton:SetAttribute("IsActive", not ImageButton:GetAttribute("IsActive"))
				end
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isDragging and isConfigMode and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local screenBounds = ScreenGui.AbsoluteSize
			local destX = math.clamp(input.Position.X - dragOffset.X + 25, 25, screenBounds.X - 25)
			local destY = math.clamp(input.Position.Y - dragOffset.Y + 25, 25, screenBounds.Y - 25)
			targetPosition = UDim2.new(0, destX, 0, destY)
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		dt = math.min(dt, 0.05)
		local force = 180 * (spring.target - spring.pos)
		spring.vel = spring.vel + (force - 24 * spring.vel) * dt
		spring.pos = spring.pos + spring.vel * dt
		ImageButton.Size = UDim2.new(0, 50 * spring.pos, 0, 50 * spring.pos)
		local tMod = (spring.pos < 1) and spring.pos or (1 - (spring.pos - 1))
		local pulse = (isConfigMode and not isDragging) and (math.sin(os.clock() * 3.5) + 1) * 0.05 or 0
		ImageButton.ImageTransparency, InnerStroke.Transparency, OuterStroke.Transparency = (0.5 * tMod) + pulse, (0.75 * tMod) + pulse, (0.5 * tMod) + pulse
		OuterStroke.Color = (not isConfigMode and data.Name == "Macro" and ImageButton:GetAttribute("IsActive")) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(0, 0, 0)
		ImageButton.Position = ImageButton.Position:Lerp(targetPosition, 15 * dt)
	end)
	
	if data.Name == "Macro" then
		local isLockActive, timer, TOGGLE_RATE = false, 0, 1/60
		RunService.Heartbeat:Connect(function(dt)
			if not ImageButton:GetAttribute("IsActive") or isConfigMode then return end
			-- PERSISTENCE: Re-fetch everything inside the loop
			local char = localPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not hum or not root then return end
			timer += dt
			if timer >= TOGGLE_RATE then timer = 0 isLockActive = not isLockActive end
			if isLockActive and not hum.Sit then
				hum.AutoRotate = false
				local _, camYaw, _ = workspace.CurrentCamera.CFrame:ToEulerAnglesYXZ()
				local curPitch, _, curRoll = root.CFrame:ToEulerAnglesYXZ()
				root.CFrame = CFrame.new(root.Position) * CFrame.fromEulerAnglesYXZ(curPitch, camYaw, curRoll)
			else hum.AutoRotate = true end
		end)
	end
end

