local NotificationLib = {}
local ActiveToasts = {}
local TOAST_SPACING = 45 
local DEFAULTS = {
	TENSION = 180, FRICTION = 24, STAGGER_DELAY = 0.015,
	GLOBAL_START_SCALE = 0.5, GLOBAL_FINAL_SCALE = 1.0,
	FRAME_TARGET_TRANS = 0.25, TARGET_FONT_SIZE = 16,
	HOLDER_PADDING = 40, MIN_WIDTH = 40,
	INTER_ID = 12187365364, Y_OFFSET = -113 
}

local function getCharMetadata(text)
	local chars = {}
	local currentTransparency, stack, i = 0, {}, 1
	while i <= #text do
		local char = text:sub(i, i)
		if char == "<" then
			local tagEnd = text:find(">", i)
			if not tagEnd then i += 1 continue end
			local tag = text:sub(i, tagEnd)
			local transMatch = tag:match('transparency%s*=%s*["\']([%d%.]+)["\']')
			if transMatch then table.insert(stack, currentTransparency) currentTransparency = tonumber(transMatch)
			elseif tag:find("^</font") and #stack > 0 then currentTransparency = table.remove(stack) end
			i = tagEnd + 1
		else
			local fullChar = text:match(utf8.charpattern, i)
			if fullChar then i += #fullChar
				local nextChar = text:match(utf8.charpattern, i)
				if nextChar then local cp = utf8.codepoint(nextChar) if cp >= 0xFE00 and cp <= 0xFE0F then fullChar ..= nextChar i += #nextChar end end
				table.insert(chars, {char = fullChar, baseTrans = currentTransparency})
			else i += 1 end
		end
	end
	return chars
end

local function updateStackPositions()
	local count = #ActiveToasts
	for i, toast in ipairs(ActiveToasts) do toast:updateTargetY(DEFAULTS.Y_OFFSET - ((count - i) * TOAST_SPACING)) end
end

function NotificationLib.new(rawText, customConfig)
	local cfg = setmetatable(customConfig or {}, {__index = DEFAULTS})
	local self = {rawContent = rawText, count = 1, isHiding = false, lifeTime = 0, maxLife = 6}
	
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "Toast"
	ScreenGui.Parent = localPlayer:WaitForChild("PlayerGui")
	ScreenGui.ResetOnSpawn = false -- Ensure notifications don't vanish on death

	local Frame = Instance.new("Frame")
	local UICorner = Instance.new("UICorner")
	local UIScale = Instance.new("UIScale")
	local TextLabel = Instance.new("TextLabel")

	Frame.Parent = ScreenGui
	Frame.AnchorPoint = Vector2.new(0.5, 1)
	Frame.BackgroundColor3 = Color3.fromRGB(25, 27, 29)
	Frame.BackgroundTransparency = 1
	Frame.Position = UDim2.new(0.5, 0, 1, cfg.Y_OFFSET)
	Frame.Size = UDim2.new(0, cfg.MIN_WIDTH, 0, 40)
	Frame.ClipsDescendants = true
	UICorner.CornerRadius = UDim.new(0, 20)
	UICorner.Parent = Frame
	UIScale.Parent = Frame
	UIScale.Scale = cfg.GLOBAL_START_SCALE

	TextLabel.Parent = Frame
	TextLabel.Size = UDim2.new(1, 0, 1, 0)
	TextLabel.BackgroundTransparency = 1
	TextLabel.FontFace = Font.fromId(cfg.INTER_ID)
	TextLabel.TextColor3 = Color3.fromRGB(250, 250, 250)
	TextLabel.TextSize = cfg.TARGET_FONT_SIZE
	TextLabel.RichText = true
	TextLabel.TextXAlignment = Enum.TextXAlignment.Center

	local currentDisplayText = rawText
	local charMetadata = getCharMetadata(currentDisplayText)
	local charSprings, globalSpring, ySpring = {}, {pos = 0, vel = 0}, {pos = cfg.Y_OFFSET, vel = 0, target = cfg.Y_OFFSET}
	for i = 1, #charMetadata do charSprings[i] = {pos = 0, vel = 0} end
	local activeConnection = nil

	function self:updateTargetY(newY) ySpring.target = newY end
	function self:increment()
		self.count += 1
		self.lifeTime = 0
		local suffix = string.format(" <font transparency='0.25'><i><b>(%dx)</b></i></font>", self.count)
		currentDisplayText = self.rawContent .. suffix
		local newMeta = getCharMetadata(currentDisplayText)
		for i = #charMetadata + 1, #newMeta do charSprings[i] = {pos = 0, vel = 0} end
		charMetadata = newMeta
	end

	function self:show()
		table.insert(ActiveToasts, self)
		updateStackPositions()
		local startTime = os.clock()
		activeConnection = RunService.RenderStepped:Connect(function(dt)
			dt = math.min(dt, 0.05)
			if not self.isHiding then self.lifeTime += dt if self.lifeTime >= self.maxLife then self:hide() end end
			local gForce = cfg.TENSION * (1 - globalSpring.pos)
			globalSpring.vel = globalSpring.vel + (gForce - cfg.FRICTION * globalSpring.vel) * dt
			globalSpring.pos = globalSpring.pos + globalSpring.vel * dt
			local yForce = cfg.TENSION * (ySpring.target - ySpring.pos)
			ySpring.vel = ySpring.vel + (yForce - cfg.FRICTION * ySpring.vel) * dt
			ySpring.pos = ySpring.pos + ySpring.vel * dt
			UIScale.Scale = cfg.GLOBAL_START_SCALE + (globalSpring.pos * (cfg.GLOBAL_FINAL_SCALE - cfg.GLOBAL_START_SCALE))
			Frame.BackgroundTransparency = math.clamp(1 - (globalSpring.pos * (1 - cfg.FRAME_TARGET_TRANS)), cfg.FRAME_TARGET_TRANS, 1)
			Frame.Position = UDim2.new(0.5, 0, 1, math.round(ySpring.pos))
			local builtString, charIndex, textIndex = "", 1, 1
			while textIndex <= #currentDisplayText do
				local byte = currentDisplayText:sub(textIndex, textIndex)
				if byte == "<" then local tagEnd = currentDisplayText:find(">", textIndex) builtString ..= currentDisplayText:sub(textIndex, tagEnd) textIndex = tagEnd + 1
				else
					local data, meta = charSprings[charIndex], charMetadata[charIndex]
					local delay = (charIndex <= #getCharMetadata(self.rawContent)) and (charIndex - 1) * cfg.STAGGER_DELAY or 0
					if os.clock() >= startTime + delay then
						local cForce = cfg.TENSION * (1 - data.pos)
						data.vel = data.vel + (cForce - cfg.FRICTION * data.vel) * dt
						data.pos = data.pos + data.vel * dt
					end
					builtString ..= string.format('<font size="%d" transparency="%.3f">%s</font>', math.max(0, math.floor(data.pos * cfg.TARGET_FONT_SIZE + 0.5)), 1 - (math.clamp(data.pos, 0, 1) * (1 - meta.baseTrans)), meta.char)
					textIndex += #meta.char charIndex += 1
				end
			end
			TextLabel.Text = builtString
			Frame.Size = UDim2.new(0, math.max(cfg.MIN_WIDTH, TextLabel.TextBounds.X + cfg.HOLDER_PADDING), 0, 40)
		end)
		return self
	end

	function self:hide()
		if self.isHiding then return end
		self.isHiding = true
		for i, v in ipairs(ActiveToasts) do if v == self then table.remove(ActiveToasts, i) break end end
		updateStackPositions()
		if activeConnection then activeConnection:Disconnect() end
		activeConnection = RunService.RenderStepped:Connect(function(dt)
			dt = math.min(dt, 0.05)
			local gForce = cfg.TENSION * (0 - globalSpring.pos)
			globalSpring.vel = globalSpring.vel + (gForce - cfg.FRICTION * globalSpring.vel) * dt
			globalSpring.pos = globalSpring.pos + globalSpring.vel * dt
			local yForce = cfg.TENSION * (ySpring.target - ySpring.pos)
			ySpring.vel = ySpring.vel + (yForce - cfg.FRICTION * ySpring.vel) * dt
			ySpring.pos = ySpring.pos + ySpring.vel * dt
			Frame.Position = UDim2.new(0.5, 0, 1, math.round(ySpring.pos))
			if globalSpring.pos <= 0.005 then activeConnection:Disconnect() ScreenGui:Destroy() end
		end)
	end
	return self
end

local function spawnToast(text, duration)
	for _, toast in ipairs(ActiveToasts) do if toast.rawContent == text and not toast.isHiding then toast:increment() return end end
	local t = NotificationLib.new(text) t.maxLife = duration or 6 t:show()
end

